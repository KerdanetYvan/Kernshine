{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kernshine",
  "version": "../package.json",
  "identifier": "fr.kernshine.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kernshine",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#FDFBF7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Application de maintenance PC pour Windows",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "French"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MkM4MDhENjIyQzg0NjAKUldSZ2hDeGlqWUFzdERLNDl2aXdZQWp5aVZucG9BNG0rcEptN1ZDWk5vbE93TzZodjZVNGpMY1UK",
      "endpoints": [
        "https://github.com/KerdanetYvan/Kernshine/releases/download/canal-alpha/latest.json"
      ],
      "windows": {
        "installMode": "passive",
        "installerArgs": [
          "/R"
        ]
      }
    }
  }
}
